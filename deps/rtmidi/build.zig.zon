.{
    .name = .rtmidi,
    .version = "6.0.0",
    .fingerprint = 0x40cfe348e41e8ba4,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .rtmidi_upstream = .{
            .url = "https://github.com/thestk/rtmidi/archive/refs/tags/6.0.0.tar.gz",
            .hash = "N-V-__8AAIOxDgCY11mjdyXJkToI9UESZx-fAKRYpcgQLi9c",
            .lazy = false,
        },
        // Linux backend: vendored static libasound (sibling deps/alsa shim).
        // Lazy + only requested on Linux, so macOS/Windows builds never fetch or
        // compile the Linux-only alsa sources.
        .alsa = .{
            .path = "../alsa",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
