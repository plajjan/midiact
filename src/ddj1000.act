"""Pioneer DDJ-1000 helpers built on top of the midi module."""

import midi

DEFAULT_SOURCE = "DDJ-1000"

actor Controller(cap: midi.MidiCap,
                 on_event: action(Controller, midi.Event) -> None):
    """DDJ-1000 MIDI controller actor.

    This currently forwards decoded MIDI messages. Device-specific named
    controls can be layered here once we have captured the DDJ-1000's messages.
    """
    var _callback = on_event

    def _on_event(input: midi.Input, event: midi.Event) -> None:
        _callback(self, event)

    action def set_callback(handler: action(Controller, midi.Event) -> None) -> None:
        _callback = handler

    _input = midi.Input(cap, _on_event, source_name=DEFAULT_SOURCE)

    action def close() -> None:
        _input.close()
