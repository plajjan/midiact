"""Shared terminal rendering helpers for VU meters."""

import term

BRAILLE_CELLS = 40
DOTS_PER_CELL = 8

def percent(value: int, max_value: int) -> int:
    if max_value < 1:
        return 0
    p = value * 100 // max_value
    if p < 0:
        return 0
    if p > 100:
        return 100
    return p

def braille_glyph(fill: int) -> str:
    if fill < 1:
        return "⠂"
    if fill == 1:
        return "⡀"
    if fill == 2:
        return "⣀"
    if fill == 3:
        return "⣄"
    if fill == 4:
        return "⣤"
    if fill == 5:
        return "⣦"
    if fill == 6:
        return "⣶"
    if fill == 7:
        return "⣷"
    return "⣿"

def cell_color(cell: int) -> str:
    pct = (cell + 1) * 100 // BRAILLE_CELLS
    if pct < 60:
        return term.green
    if pct < 85:
        return term.yellow
    return term.red

def level_color(level: int) -> str:
    if level < 60:
        return term.green
    if level < 85:
        return term.yellow
    return term.red

def braille_bar(level: int, peak: int) -> str:
    total_dots = level * BRAILLE_CELLS * DOTS_PER_CELL // 100
    peak_dot = peak * BRAILLE_CELLS * DOTS_PER_CELL // 100
    peak_cell = peak_dot // DOTS_PER_CELL
    if peak_cell < 0:
        peak_cell = 0
    if peak_cell >= BRAILLE_CELLS:
        peak_cell = BRAILLE_CELLS - 1

    res = ""
    for i in range(BRAILLE_CELLS):
        cell_start = i * DOTS_PER_CELL
        fill = total_dots - cell_start
        if fill < 0:
            fill = 0
        if fill > DOTS_PER_CELL:
            fill = DOTS_PER_CELL

        if i == peak_cell and peak > level:
            res += term.bold + term.white + "⣿" + term.normal
        elif fill > 0:
            res += cell_color(i) + braille_glyph(fill) + term.normal
        else:
            res += term.grey9 + braille_glyph(0) + term.normal
    return res
